  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "cothink": "./bin/cothink.js"
  },
  "scripts": {
    "test": "node --test test/native-background.test.js test/pi-*.test.js test/agent-sync-*.test.js test/versioning-contract.test.js test/clipboard.test.js test/final-display.test.js",
    "test:terminal": "python3 test/pi_terminal_checks.py && python3 test/pi_slash_checks.py && python3 test/pi_changelog_checks.py",
    "start": "node bin/cothink.js",
    "test:pi": "node --test test/pi-*.test.js",
    "test:pi-terminal": "python3 test/pi_terminal_checks.py && python3 test/pi_slash_checks.py && python3 test/pi_changelog_checks.py",
    "build:pi": "node scripts/build-pi-deps.mjs",
    "test:sync": "node --test test/versioning-contract.test.js test/agent-sync-*.test.js",
    "test:work": "node --test test/agent-sync-dispatch.test.js test/agent-sync-entrypoints.test.js",
    "test:agent-sync-core": "node --test packages/agent-sync/test/*.test.js",
    "test:packages": "node --test test/pi-packages.test.js",
    "test:windows": "node --test test/pi-windows.test.js test/pi-kimi.test.js test/clipboard.test.js test/pi-session.test.js test/pi-setup-io.test.js test/pi-discussion.test.js",
    "pack:npm": "node scripts/pack-npm.mjs",
    "build:gui": "vite build --config gui/vite.config.js",
    "gui": "node bin/cothink.js gui",
    "test:gui": "node --test test/gui-*.test.js",
    "test:visual": "node --test test/visual-bench*.test.js test/visual-preview.test.js test/visual-workflow.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "file:vendor/pi-deps/anthropic-ai-sdk-0.129.0.tgz",
    "@earendil-works/pi-ai": "1.4.0",
